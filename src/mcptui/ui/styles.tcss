Screen {
    background: #0d1117;
    color: #c9d1d9;
}

#top-header {
    height: 3;
    background: #161b22;
    border-bottom: solid #30363d;
    padding: 0 1;
    layout: horizontal;
    align: left middle;
}

#brand-label {
    text-style: bold;
    color: #58a6ff;
    height: 1;
    margin-right: 1;
}

#server-pill {
    height: 1;
    padding: 0 1;
    background: #21262d;
    color: #7ee787;
    text-style: bold;
    margin-right: 1;
}

#server-pill.disconnected {
    color: #f85149;
}

#header-buttons {
    layout: horizontal;
    height: 1;
}

#header-buttons Button {
    margin-left: 1;
    height: 1;
    min-width: 16;
    border: none;
    background: #21262d;
    color: #8b949e;
}

#header-buttons Button:hover {
    background: #30363d;
    color: #ffffff;
}

/* Tabs & Content Switcher Expansion */
TabbedContent {
    height: 1fr;
}

ContentSwitcher {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 0;
}

/* Common Split Layout */
.split-view {
    layout: horizontal;
    height: 1fr;
    width: 100%;
}

.sidebar {
    width: 28;
    min-width: 24;
    max-width: 36;
    height: 1fr;
    border-right: solid #30363d;
    background: #161b22;
    padding: 0 1;
}

.sidebar-search {
    margin: 1 0;
    height: 3;
    border: solid #30363d;
    background: #0d1117;
}

.sidebar-search:focus {
    border: solid #58a6ff;
}

.item-list {
    height: 1fr;
    background: transparent;
    border: none;
}

.main-content {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    layout: vertical;
    overflow-y: auto;
}

/* Tool Header & Description */
.item-meta-box {
    height: auto;
    max-height: 5;
    background: #161b22;
    border: solid #30363d;
    padding: 0 1;
    margin-top: 1;
}

.item-title {
    text-style: bold;
    color: #58a6ff;
}

.item-desc {
    color: #8b949e;
}

/* Input Workspace */
.input-section-title {
    color: #79c0ff;
    text-style: bold;
    margin-top: 1;
}

.param-editor {
    height: 6;
    min-height: 4;
    border: solid #30363d;
    background: #0d1117;
    margin-bottom: 0;
}

.param-editor:focus {
    border: solid #58a6ff;
}

/* Action Controls Bar */
.action-bar {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin: 1 0;
}

.action-bar Button {
    margin-right: 1;
    height: 3;
}

#btn-execute {
    background: #238636;
    color: #ffffff;
    text-style: bold;
}

#btn-execute:hover {
    background: #2ea043;
}

#btn-copy, #btn-copy-res, #btn-copy-prompt, #btn-copy-req, #btn-copy-resp {
    background: #21262d;
    color: #c9d1d9;
}

#btn-copy:hover, #btn-copy-res:hover, #btn-copy-prompt:hover, #btn-copy-req:hover, #btn-copy-resp:hover {
    background: #30363d;
}

#status-pill, #res-status-pill, #prompt-status-pill, #history-status-pill {
    padding: 0 1;
    color: #8b949e;
    text-style: bold;
    content-align: right middle;
}

#status-pill.success, #res-status-pill.success, #prompt-status-pill.success {
    color: #7ee787;
}

#status-pill.error, #res-status-pill.error, #prompt-status-pill.error {
    color: #f85149;
}

#status-pill.running, #res-status-pill.running, #prompt-status-pill.running {
    color: #e3b341;
}

/* Response Box */
.response-box {
    height: 1fr;
    min-height: 6;
    border: solid #30363d;
    background: #0d1117;
    padding: 0 1;
}

.response-box:focus {
    border: solid #58a6ff;
}

/* Log & Protocol Views */
.log-view {
    height: 1fr;
    width: 100%;
    padding: 0 1;
    background: #0d1117;
    layout: vertical;
}

#protocol-log {
    height: 1fr;
    border: solid #30363d;
    background: #0d1117;
}

/* Server Switcher Modal */
#server-modal-container {
    width: 60;
    height: 24;
    background: #161b22;
    border: thick #58a6ff;
    padding: 1 2;
    align: center middle;
}

#modal-title {
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
    content-align: center middle;
}

#server-select-list {
    height: 12;
    border: solid #30363d;
    background: #0d1117;
    margin-bottom: 1;
}

.modal-buttons {
    layout: horizontal;
    align: center middle;
    height: 3;
}

.modal-buttons Button {
    margin: 0 1;
}
